# ===================================================================
# Discord Bot - Environment Configuration (.env)
# ===================================================================
# NOTE: Only sensitive secrets, API tokens, and server hosting settings
# belong in this file.
#
# Server-specific operational settings (bot prefix, announcement roles,
# LOA channels, LOA timezone, logging channels, module toggles) can all be
# configured directly in Discord using slash commands:
#   • /settings prefix <new_prefix>
#   • /announcement_roles add <role>
#   • /loa_setup and /loa_config
#   • /log setup <channel>
#   • /module enable/disable <module>
# ===================================================================

# Discord Bot Token (Required - from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord OAuth2 Credentials (Optional, for web dashboard login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/callback

# Web Dashboard Server Configuration
WEB_SECRET_KEY=change_this_to_a_random_secure_secret_string
WEB_DASHBOARD_PORT=5000
WEB_DASHBOARD_HOST=0.0.0.0

# Moderation & Role Management Engine (Optional overrides)
# MODERATION_RATE_LIMIT_DELAY=1.2       # Seconds between sequential moderation API calls
# MODERATION_BULK_MAX_TARGETS=250       # Maximum member targets permitted in a single bulk job
# MODERATION_WATCHDOG_INTERVAL=30       # Watchdog check interval (seconds) for expired tempbans

